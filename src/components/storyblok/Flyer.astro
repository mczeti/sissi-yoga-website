---
const { blok } = Astro.props
// Felder: blok.titel, blok.gueltig_ab (ISO datetime), blok.bild (Storyblok asset),
//         blok.zielgruppe ('kinder' | 'erwachsene'), blok.ausgebucht, blok.featured

const datum = blok.gueltig_ab
  ? new Date(blok.gueltig_ab).toLocaleDateString('de-AT', { day: 'numeric', month: 'long', year: 'numeric' })
  : null
const isPdf = blok.bild?.filename?.toLowerCase().endsWith('.pdf')
const grp = blok.zielgruppe === 'kinder' ? 'kinder' : 'erwachsene'
const cat = grp === 'kinder'
  ? { label: 'Kinderyoga', color: 'var(--color-sissi-green)' }
  : { label: 'Erwachsenenyoga', color: 'var(--color-sissi-olive)' }
const clickable = !blok.ausgebucht && blok.bild?.filename
const Tag = clickable ? 'a' : 'div'
---

<article class:list={['flyer-card rounded-2xl overflow-hidden bg-white shadow-md transition-shadow', { 'is-sold': blok.ausgebucht, 'hover:shadow-xl': clickable }]} data-group={grp}>
  <Tag href={clickable ? blok.bild.filename : undefined} target={clickable ? '_blank' : undefined} rel="noopener" class="group block relative overflow-hidden">
    <span class="accent" style={`background:${cat.color}`}></span>
    {isPdf ? (
      <div class="flex flex-col items-center justify-center gap-3 p-10" style="background-color: var(--color-sissi-cream)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 opacity-40" style="color: var(--color-sissi-olive)" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" /></svg>
        <span class="text-xs font-medium" style="color: var(--color-sissi-green)">PDF öffnen</span>
      </div>
    ) : blok.bild?.filename && (
      <img src={blok.bild.filename} alt={blok.titel ?? 'Flyer'} class="w-full block transition-transform duration-500 group-hover:scale-105" />
    )}
    {blok.featured && !blok.ausgebucht && (
      <span class="badge">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.3 6.9.7-5.1 4.7 1.4 6.8L12 17.8 5.9 21.3l1.4-6.8L2.2 9.7l6.9-.7L12 2z"/></svg>
        Tipp
      </span>
    )}
    {blok.ausgebucht && <div class="sold-band">Ausgebucht</div>}
  </Tag>
  <div class="p-4">
    <span class="inline-block text-[11px] font-semibold tracking-wide px-2.5 py-1 rounded-full mb-2" style={`color:${cat.color}; background: color-mix(in srgb, ${cat.color} 14%, white)`}>{cat.label}</span>
    {blok.titel && <p class="font-semibold text-sm" style="color: var(--color-sissi-olive)">{blok.titel}</p>}
    {blok.ausgebucht ? (
      <a href="/kontakt" class="text-xs mt-1 inline-block font-medium" style="color: var(--color-sissi-green)">Warteliste – jetzt anfragen →</a>
    ) : (
      datum && <p class="text-xs mt-1" style="color: var(--color-sissi-circle)">Ab {datum}</p>
    )}
  </div>
</article>

<style>
  .accent { position: absolute; top: 0; left: 0; right: 0; height: 4px; z-index: 2; }
  .badge {
    position: absolute; top: .75rem; left: .75rem; z-index: 3;
    display: inline-flex; align-items: center; gap: .35rem;
    padding: .3rem .7rem; border-radius: 9999px;
    font-size: .7rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase;
    background: var(--color-sissi-green); color: white;
  }
  .sold-band {
    position: absolute; top: 50%; left: 0; right: 0; transform: translateY(-50%);
    z-index: 3; text-align: center; padding: .55rem 0;
    font-weight: 700; letter-spacing: .16em; text-transform: uppercase; font-size: .8rem;
    color: #fff; background: #a5462f;
  }
  .is-sold img { filter: grayscale(.85) brightness(.95); opacity: .6; transform: none !important; }
  .is-sold { cursor: default; }
</style>
