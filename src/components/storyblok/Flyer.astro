---
const { blok } = Astro.props
// blok.titel, blok.gueltig_ab (ISO datetime), blok.bild (Storyblok asset)

const datum = blok.gueltig_ab
  ? new Date(blok.gueltig_ab).toLocaleDateString('de-AT', { day: 'numeric', month: 'long', year: 'numeric' })
  : null
---

<div class="rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow bg-white">
  {blok.bild?.filename && (
    <a href={blok.bild.filename} target="_blank" rel="noopener">
      <img
        src={blok.bild.filename}
        alt={blok.titel ?? 'Flyer'}
        class="w-full object-cover"
      />
    </a>
  )}
  <div class="p-4">
    {blok.titel && (
      <p class="font-semibold text-sm" style="color: var(--color-sissi-olive)">{blok.titel}</p>
    )}
    {datum && (
      <p class="text-xs mt-1" style="color: var(--color-sissi-circle)">Ab {datum}</p>
    )}
  </div>
</div>
