---
// Hochformat-Video im "Instagram-Story"-Rahmen (Hero der Startseite).
//
// Video-Dateien liegen in public/video/hero/ und werden mit
// scripts/encode-hero-video.sh aus dem Original erzeugt:
//   master.m3u8 + 360p/540p/720p/*   → adaptives Streaming (HLS)
//   hero-720.mp4                     → Fallback ohne HLS
//   poster.jpg                       → erstes Frame (immer vorhanden)
// Fehlt das Video, zeigt der Rahmen nur das Poster – die Seite funktioniert trotzdem.
import { existsSync } from 'node:fs'
import { join } from 'node:path'

interface Props {
  title?: string
  subtitle?: string
  arch?: boolean
}

const {
  title = 'Kinderyoga im Kreis',
  subtitle = 'Purkersdorf · jeden Mittwoch',
  arch = false,
} = Astro.props

const dir = join(process.cwd(), 'public/video/hero')
const hls = existsSync(join(dir, 'master.m3u8')) ? '/video/hero/master.m3u8' : undefined
const mp4 = existsSync(join(dir, 'hero-720.mp4')) ? '/video/hero/hero-720.mp4' : undefined
const hasVideo = Boolean(hls || mp4)
const poster = '/video/hero/poster.jpg'
---

<div class="stage">
  <div class="blob" aria-hidden="true"></div>
  <img class="tilt" src="/images/achtsamkeit-ritual.jpg" alt="" width="190" height="250" loading="lazy" decoding="async" />

  <div class:list={['story', { arch }]} data-story>
    {hasVideo ? (
      <video
        poster={poster}
        muted
        loop
        playsinline
        preload="none"
        aria-label={`${title} – ${subtitle}`}
        data-hls={hls}
        data-mp4={mp4}
      ></video>
    ) : (
      <img src={poster} alt={`${title} – ${subtitle}`} class="story-poster" fetchpriority="high" />
    )}

    <div class="story-top">
      <div class="bars" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="handle">
        <img src="/logos/logo-circle.png" alt="" width="30" height="30" />sissi.familien.yogazeit
      </div>
    </div>

    <div class="caption">
      <div><strong>{title}</strong><small>{subtitle}</small></div>
      {hasVideo && <button class="sound" type="button" aria-label="Ton einschalten" data-sound hidden>Ton</button>}
    </div>
  </div>

  <a class="ig-card" href="https://www.instagram.com/sissi.familien.yogazeit" target="_blank" rel="noopener">
    <span>Mehr auf Instagram</span>@sissi.familien.yogazeit →
  </a>
</div>

<script>
  const story = document.querySelector<HTMLElement>('[data-story]')
  const video = story?.querySelector<HTMLVideoElement>('video')
  const soundBtn = story?.querySelector<HTMLButtonElement>('[data-sound]')

  if (story && video) {
    const conn = (navigator as any).connection
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches
    const saveData = Boolean(conn?.saveData) || /(^|-)2g$/.test(conn?.effectiveType ?? '')

    // Bewegung/Datenvolumen respektieren: nur Poster, kein Video-Download
    if (reduceMotion || saveData) {
      story.dataset.still = ''
    } else {
      let hlsInstance: { destroy(): void } | undefined
      let started = false

      const playMp4 = () => {
        hlsInstance?.destroy()
        hlsInstance = undefined
        if (video.dataset.mp4) {
          video.src = video.dataset.mp4
          video.play().catch(() => {})
        }
      }

      const start = async () => {
        if (started) return
        started = true
        const hlsUrl = video.dataset.hls

        if (hlsUrl && video.canPlayType('application/vnd.apple.mpegurl')) {
          // Safari/iOS: nativer HLS-Player
          video.src = hlsUrl
          video.play().catch(() => {})
        } else if (hlsUrl) {
          try {
            // hls.js wird nur für Browser ohne natives HLS nachgeladen (eigener Chunk)
            const { default: Hls } = await import('hls.js')
            if (!Hls.isSupported()) return playMp4()
            const hls = new Hls({ capLevelToPlayerSize: true, maxBufferLength: 12 })
            hlsInstance = hls
            hls.on(Hls.Events.ERROR, (_e, data) => { if (data.fatal) playMp4() })
            hls.loadSource(hlsUrl)
            hls.attachMedia(video)
            video.play().catch(() => {})
          } catch {
            playMp4()
          }
        } else {
          playMp4()
        }
      }

      // Erst nach dem Laden der Seite (Poster = LCP bleibt unbehindert)
      const schedule = () => ('requestIdleCallback' in window
        ? requestIdleCallback(() => start(), { timeout: 2500 })
        : setTimeout(start, 300))
      if (document.readyState === 'complete') schedule()
      else window.addEventListener('load', schedule, { once: true })

      // Story-Fortschrittsbalken so lang wie das Video
      video.addEventListener('loadedmetadata', () => {
        if (isFinite(video.duration)) story.style.setProperty('--story-duration', `${video.duration}s`)
      })
      video.addEventListener('playing', () => {
        story.dataset.playing = ''
        if (soundBtn) soundBtn.hidden = false
      }, { once: true })

      // Außerhalb des Bildschirms pausieren (Akku, Daten)
      new IntersectionObserver(([entry]) => {
        if (!started) return
        if (entry.isIntersecting) video.play().catch(() => {})
        else video.pause()
      }, { threshold: 0.25 }).observe(story)
    }

    soundBtn?.addEventListener('click', () => {
      video.muted = !video.muted
      soundBtn.textContent = video.muted ? 'Ton' : 'Stumm'
      soundBtn.setAttribute('aria-label', video.muted ? 'Ton einschalten' : 'Ton ausschalten')
      if (!video.muted) video.play().catch(() => {})
    })
  }
</script>

<style>
  .stage { position: relative; height: 700px; display: flex; align-items: center; justify-content: center; }
  .blob {
    position: absolute; width: 440px; height: 560px;
    border-radius: 52% 48% 44% 56% / 46% 54% 46% 54%;
    background: var(--color-sissi-sage); opacity: .55; transform: rotate(-8deg);
  }
  .tilt {
    position: absolute; left: 0; top: 90px; width: 190px; height: 250px; object-fit: cover;
    border-radius: 18px; transform: rotate(-7deg); box-shadow: 0 18px 40px rgba(38, 56, 45, .22);
  }
  .story {
    position: relative; width: 360px; aspect-ratio: 9 / 16; border-radius: 28px; overflow: hidden;
    background: var(--color-sissi-ink); box-shadow: 0 30px 70px rgba(38, 56, 45, .35); border: 6px solid #fff;
    --story-duration: 8s;
  }
  .story.arch { border-radius: 180px 180px 28px 28px; }
  .story.arch .story-top { display: none; }
  .story video, .story-poster { width: 100%; height: 100%; object-fit: cover; display: block; }

  .bars { position: absolute; top: 14px; left: 14px; right: 14px; display: flex; gap: 5px; }
  .bars i { flex: 1; height: 3px; border-radius: 2px; background: rgba(255, 255, 255, .4); overflow: hidden; }
  .bars i:first-child::after {
    content: ""; display: block; height: 100%; background: #fff; transform-origin: left;
    animation: prog var(--story-duration) linear infinite;
  }
  [data-still] .bars i:first-child::after { animation: none; transform: scaleX(1); }
  @keyframes prog { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .handle {
    position: absolute; top: 28px; left: 14px; display: flex; align-items: center; gap: 9px;
    color: #fff; font-size: 13px; font-weight: 500; text-shadow: 0 1px 4px rgba(0, 0, 0, .4);
  }
  .handle img { width: 30px; height: 30px; border-radius: 50%; background: #fff; object-fit: cover; }

  .caption {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 70px 20px 20px;
    background: linear-gradient(transparent, rgba(20, 32, 25, .75)); color: #fff;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 12px;
  }
  .caption strong { display: block; font-family: var(--font-serif); font-weight: 400; font-size: 22px; }
  .caption small { font-size: 13px; opacity: .9; }
  .sound {
    width: 44px; height: 44px; border-radius: 50%; border: 0; background: rgba(255, 255, 255, .22);
    color: #fff; font: 600 12px var(--font-sans); cursor: pointer; backdrop-filter: blur(6px); flex: none;
  }
  .sound[hidden] { display: none; }

  .ig-card {
    position: absolute; right: -10px; top: 110px; padding: 12px 18px; border-radius: 14px; background: #fff;
    box-shadow: 0 12px 30px rgba(38, 56, 45, .18); font-size: 14px; font-weight: 500;
    color: var(--color-sissi-ink); text-decoration: none; display: flex; flex-direction: column; gap: 2px;
    transform: rotate(3deg);
  }
  .ig-card span { font-size: 12px; color: var(--color-sissi-terracotta); font-weight: 600; }

  @media (max-width: 899px) {
    .stage { height: 600px; order: 4; }
    .blob { width: 330px; height: 440px; }
    .tilt, .ig-card { display: none; }
    .story { width: 300px; border-width: 5px; }
  }
</style>
