---
const links = [
  { label: 'Kinderyoga',    href: '/kinderyoga' },
  { label: 'Familienyoga',  href: '/familienyoga' },
  { label: 'Prä & Postnatal', href: '/praenatal' },
  { label: 'Schulen',       href: '/schulen' },
  { label: 'Kontakt',       href: '/kontakt' },
]

const currentPath = Astro.url.pathname
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="navbar">
  <div class="max-w-6xl mx-auto px-6 md:px-16 h-16 flex items-center justify-between">

    <!-- Logo -->
    <a href="/" class="shrink-0">
      <img src="/logos/logo-colored.png" alt="Sissi Familien Yogazeit" class="h-10" id="nav-logo" />
    </a>

    <!-- Desktop links -->
    <nav class="hidden md:flex items-center gap-8">
      {links.map(link => (
        <a
          href={link.href}
          class={`text-sm font-medium transition-colors hover:opacity-70 ${
            currentPath === link.href ? 'border-b-2' : ''
          }`}
          style={currentPath === link.href
            ? 'color: var(--color-sissi-olive); border-color: var(--color-sissi-green)'
            : 'color: var(--color-sissi-olive)'}
          id="nav-link"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Mobile hamburger -->
    <button id="menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Menü öffnen">
      <span class="w-6 h-0.5 rounded transition-all" style="background-color: var(--color-sissi-olive)" id="bar1"></span>
      <span class="w-6 h-0.5 rounded transition-all" style="background-color: var(--color-sissi-olive)" id="bar2"></span>
      <span class="w-6 h-0.5 rounded transition-all" style="background-color: var(--color-sissi-olive)" id="bar3"></span>
    </button>

  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden px-6 pb-6 flex flex-col gap-4" style="background-color: var(--color-sissi-cream)">
    {links.map(link => (
      <a
        href={link.href}
        class="text-base font-medium py-2 border-b border-black/5"
        style="color: var(--color-sissi-olive)"
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const navbar = document.getElementById('navbar')
  const menuBtn = document.getElementById('menu-btn')
  const mobileMenu = document.getElementById('mobile-menu')
  const isHero = document.querySelector('[data-hero]')

  // Scroll: transparenter Header auf Hero-Seiten, weißer Header sonst
  function updateNav() {
    if (!navbar) return
    if (isHero && window.scrollY < 80) {
      navbar.style.backgroundColor = 'transparent'
    } else {
      navbar.style.backgroundColor = 'var(--color-sissi-cream)'
      navbar.style.boxShadow = '0 1px 0 rgba(0,0,0,0.06)'
    }
  }

  updateNav()
  window.addEventListener('scroll', updateNav)

  // Hamburger toggle
  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden')
    mobileMenu?.classList.toggle('hidden', isOpen)
  })
</script>
