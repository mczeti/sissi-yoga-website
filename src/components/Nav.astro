---
const links = [
  { label: 'Kinderyoga',      href: '/kinderyoga' },
  { label: 'Prä & Postnatal', href: '/praenatal' },
  { label: 'Senioren Yoga',   href: '/seniorenyoga' },
  { label: 'Schulen',         href: '/schulen' },
  { label: 'Workshops',       href: '/workshops' },
  { label: 'Kontakt',         href: '/kontakt' },
]

const currentPath = Astro.url.pathname
---

<header class="fixed top-0 left-0 right-0 z-50 transition-all duration-300" id="navbar">
  <div class="max-w-6xl mx-auto px-6 md:px-16 h-16 flex items-center justify-between">

    <!-- Logo: zwei Varianten, per JS umgeschalten -->
    <a href="/" class="shrink-0">
      <img src="/logos/logo-white.png"   alt="Sissi Familien Yogazeit" class="h-10 absolute" id="nav-logo-white" />
      <img src="/logos/logo-colored.png" alt="Sissi Familien Yogazeit" class="h-10"          id="nav-logo-color" />
    </a>

    <!-- Desktop links -->
    <nav class="hidden md:flex items-center gap-8" id="nav-links">
      {links.map(link => (
        <a
          href={link.href}
          class={`nav-link text-sm font-medium transition-colors hover:opacity-70 ${
            currentPath === link.href ? 'border-b-2' : ''
          }`}
          data-active={currentPath === link.href ? 'true' : 'false'}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Mobile hamburger -->
    <button id="menu-btn" class="md:hidden flex flex-col gap-1.5 p-2" aria-label="Menü öffnen">
      <span class="hamburger-bar w-6 h-0.5 rounded transition-all"></span>
      <span class="hamburger-bar w-6 h-0.5 rounded transition-all"></span>
      <span class="hamburger-bar w-6 h-0.5 rounded transition-all"></span>
    </button>

  </div>

  <!-- Mobile menu (immer cream, egal ob hero oder nicht) -->
  <div id="mobile-menu" class="hidden md:hidden px-6 pb-6 flex flex-col gap-4" style="background-color: var(--color-sissi-cream)">
    {links.map(link => (
      <a
        href={link.href}
        class="text-base font-medium py-2 border-b border-black/5"
        style="color: var(--color-sissi-olive)"
      >
        {link.label}
      </a>
    ))}
  </div>
</header>

<script>
  const navbar      = document.getElementById('navbar')
  const logoWhite   = document.getElementById('nav-logo-white')
  const logoColor   = document.getElementById('nav-logo-color')
  const navLinks    = document.querySelectorAll<HTMLElement>('.nav-link')
  const hamburgerBars = document.querySelectorAll<HTMLElement>('.hamburger-bar')
  const menuBtn     = document.getElementById('menu-btn')
  const mobileMenu  = document.getElementById('mobile-menu')
  const isHero      = document.querySelector('[data-hero]')

  function setTransparent() {
    if (!navbar) return
    navbar.style.backgroundColor = 'transparent'
    navbar.style.boxShadow = 'none'
    // Logo
    logoWhite?.style.setProperty('opacity', '1')
    logoColor?.style.setProperty('opacity', '0')
    // Links weiß
    navLinks.forEach(l => { l.style.color = 'white' })
    // Hamburger weiß
    hamburgerBars.forEach(b => { b.style.backgroundColor = 'white' })
  }

  function setSolid() {
    if (!navbar) return
    navbar.style.backgroundColor = 'var(--color-sissi-cream)'
    navbar.style.boxShadow = '0 1px 0 rgba(0,0,0,0.06)'
    // Logo
    logoWhite?.style.setProperty('opacity', '0')
    logoColor?.style.setProperty('opacity', '1')
    // Links olive
    navLinks.forEach(l => { l.style.color = 'var(--color-sissi-olive)' })
    // Hamburger olive
    hamburgerBars.forEach(b => { b.style.backgroundColor = 'var(--color-sissi-olive)' })
  }

  function updateNav() {
    if (isHero && window.scrollY < 80) {
      setTransparent()
    } else {
      setSolid()
    }
  }

  // Logo transition vorbereiten
  if (logoWhite) logoWhite.style.transition = 'opacity 0.3s'
  if (logoColor) logoColor.style.transition = 'opacity 0.3s'

  updateNav()
  window.addEventListener('scroll', updateNav)

  // Hamburger toggle
  menuBtn?.addEventListener('click', () => {
    const isOpen = !mobileMenu?.classList.contains('hidden')
    mobileMenu?.classList.toggle('hidden', isOpen)
  })
</script>
