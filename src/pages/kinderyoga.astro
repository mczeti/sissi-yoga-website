---
import SubpageLayout from '../layouts/SubpageLayout.astro'
import Faq from '../components/Faq.astro'
import { kurs } from '../data/seo'

const jsonLd = [
  kurs({
    name: 'Kinderyoga im Wienerwald',
    description: 'Spielerisches Yoga für Kinder mit Geschichten, Bewegungsspielen und kindgerechter Entspannung: wöchentliche Semesterkurse in Gruppen von ca. 8–12 Kindern sowie Workshops.',
    path: '/kinderyoga',
    orte: ['Purkersdorf', 'Tullnerbach', 'Pressbaum'],
    zielgruppe: 'Kinder'
  }),
]

const faq = [
  {
    frage: 'Wie läuft eine Kinderyoga-Stunde bei Sissi ab?',
    antwort: 'Jede Stunde beginnt mit einem Ritual, danach wärmen Bewegungs- und Laufspiele auf. Im Hauptteil werden Yoga-Asanas und Yoga-Spiele rund um eine Geschichte oder ein Thema erarbeitet, oft mit Materialien wie Yogakarten, Yogawürfel oder Schwungtuch. Zum Schluss gibt es eine kindgerechte Entspannung, etwa eine Massagegeschichte oder eine kurze Meditationsgeschichte.'
  },
  {
    frage: 'Wie groß sind die Gruppen und wie lange dauert ein Kurs?',
    antwort: 'Die Gruppen haben ca. 8–12 Kinder. Ein Kurs läuft ein Semester lang mit einer Einheit pro Woche.'
  },
  {
    frage: 'Wo findet Kinderyoga statt?',
    antwort: 'Kinderyoga-Kurse und -Workshops gibt es im Pfarrsaal Purkersdorf, Wald-Workshops für Kinder von 4 bis 9 Jahren in Tullnerbach-Lawies. Für Kindergärten und Schulen im Wienerwald kommt Sissi auch direkt in die Einrichtung.'
  },
  {
    frage: 'Was bringt Kinderyoga?',
    antwort: 'Kinderyoga fördert Gleichgewicht und innere Balance, macht mutig und kräftig und hilft Kindern, durch viel Bewegung leichter in einen entspannten Zustand zu finden, den sie auch in den Alltag mitnehmen können.'
  },
  {
    frage: 'Wie melde ich mich an?',
    antwort: 'Über das Kontaktformular auf sissiyoga.at/kontakt, per E-Mail an sissi.zehetner@gmail.com oder telefonisch unter +43 660 4860304. Aktuelle Zeiten und Termine stehen im Stundenplan auf der Startseite.'
  }
]
---

<SubpageLayout seoTitle="Kinderyoga im Wienerwald – Purkersdorf, Pressbaum, Tullnerbach | Sissi" description="Kinderyoga im Wienerwald: spielerische Yogastunden mit Geschichten, Bewegung und Entspannung für Kinder in Purkersdorf, Pressbaum und Tullnerbach. Wöchentliche Kurse pro Semester." title="Kinderyoga im Wienerwald" hero="/images/kinder-oben.JPG" jsonLd={jsonLd} heroAlt="Kinderyoga mit Sissi">

  <div class="grid md:grid-cols-2 gap-12 items-start">

    <div class="flex flex-col gap-6 text-base leading-relaxed" style="color: var(--color-sissi-olive)">
      <p>
        Tauche mit mir in eine lustige, fantasievolle Welt – voller Abenteuer. In Geschichten verpackten Einheiten lernst du auf ganz spielerische Art und Weise Yoga Asanas kennen.
      </p>
      <p>
        Gemeinsam reisen wir mit dem fliegenden Teppich, machen Bekanntschaft mit Piraten und besuchen den Zauberwald.
      </p>
      <p>
        Durch ausgiebige Bewegung haben die Kinder die Möglichkeit, besser in einen entspannten Zustand zu finden – den du auch in den Alltag mitnehmen kannst. Kinderyoga fördert das Gleichgewicht und die innere Balance, macht mutig & kräftig und vor allem macht es großen Spaß.
      </p>
      <p>
        In Gruppen von ca. 8–12 Kindern begleite ich die Kinder je ein Semester lang wöchentlich. Meine Einheiten sind stets abwechslungsreich und in verschiedenen Geschichten aufgebaut.
      </p>

      <h2 class="text-xl font-medium mt-4" style="color: var(--color-sissi-olive)">So läuft eine Einheit ab</h2>
      <p>Die Stunde startet immer mit einem Ritual – das schafft Orientierung und gibt Sicherheit.</p>
      <p>
        Danach geht es mit viel Bewegung und Laufspielen weiter – so wärmen wir unsere Körper auf und kommen ganz bei uns an.
      </p>
      <p>
        Den Hauptteil bildet je eine Geschichte bzw. ein Thema, das wir spielerisch mit vielen Yoga Asanas und Yoga Spielen erarbeiten. Hier kommen auch regelmäßig verschiedenste Materialien zum Einsatz – Tiere, Yogakarten, Yogawürfel, Schwungtuch und vieles mehr.
      </p>
      <p>
        Und weil „Savasana" – die Endentspannung – nicht fehlen darf, gibt es natürlich auch für die Kinder immer eine tolle, kindgerechte und wohltuende Entspannung. Das kann eine Massagegeschichte, ein Bilderbuch, ein Legespiel oder eine kurze angeleitete Meditationsgeschichte sein.
      </p>
    </div>

    <div class="flex flex-col gap-6">
      <img src="/images/kinderyoga.JPG" alt="Kinderyoga mit Sissi" class="w-full rounded-2xl object-cover shadow-md" />
      <img src="/images/Kinderyoga-73.JPG" alt="Kind beim Yoga" class="w-full rounded-2xl object-cover shadow-md" />
    </div>

  </div>

  <Faq items={faq} />

  <!-- CTA -->
  <div class="mt-12 p-8 rounded-2xl text-center flex flex-col items-center gap-4" style="background-color: var(--color-sissi-cream)">
    <p class="text-lg" style="color: var(--color-sissi-olive)">Interesse an einem Kinderyoga-Kurs?</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/#stundenplan" class="inline-flex items-center gap-2 px-8 py-3 rounded-full font-medium border-2 transition hover:scale-105"
         style="color: var(--color-sissi-olive); border-color: var(--color-sissi-olive)">
        Aktuelle Termine
      </a>
      <a href="/kontakt" class="inline-flex items-center gap-2 px-8 py-3 rounded-full text-white font-medium transition hover:scale-105"
         style="background-color: var(--color-sissi-olive)">
        Jetzt anfragen
      </a>
    </div>
  </div>

</SubpageLayout>
