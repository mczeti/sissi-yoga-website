---
import SubpageLayout from '../layouts/SubpageLayout.astro'
import Faq from '../components/Faq.astro'
import { kurs } from '../data/seo'

const jsonLd = [
  kurs({
    name: 'Kinderyoga für Kindergärten und Schulen',
    description: 'Mobile Kinderyoga-Angebote im Wienerwald: einmalige Workshops, mehrwöchige Kursblöcke und Fortbildungen für Pädagoginnen und Pädagogen, direkt in der Einrichtung.',
    path: '/schulen',
    orte: ['Purkersdorf', 'Pressbaum', 'Tullnerbach'],
    zielgruppe: 'Kindergärten und Schulen'
  }),
]

const faq = [
  {
    frage: 'Kommt Sissi in den Kindergarten oder in die Schule?',
    antwort: 'Ja. Sissi kommt direkt in die Einrichtung – Yoga im vertrauten Umfeld senkt die Hemmschwelle für die Kinder.'
  },
  {
    frage: 'Welche Formate gibt es für Bildungseinrichtungen?',
    antwort: 'Einmalige Workshops zu einem Thema (z. B. als Projekttag), mehrteilige Kursblöcke über mehrere Wochen und Pädagogen-Workshops, in denen Erzieher:innen und Lehrer:innen Grundlagen des Kinderyogas für den Alltag lernen.'
  },
  {
    frage: 'Welche Qualifikation hat Sissi?',
    antwort: 'Sissi (Elisabeth Zehetner) ist ausgebildete Kinderyoga-Lehrerin und Traumapädagogin und hat nach der BAKIP Amstetten zehn Jahre als Kindergartenpädagogin in Wien gearbeitet.'
  },
  {
    frage: 'Was kostet ein Workshop für unsere Einrichtung?',
    antwort: 'Sissi erstellt für jede Einrichtung ein individuelles Angebot – einfach über das Kontaktformular anfragen.'
  }
]
---

<SubpageLayout seoTitle="Yoga-Workshops für Kindergärten & Schulen im Wienerwald | Sissi" description="Kinderyoga-Workshops für Kindergärten und Schulen im Wienerwald: Bewegung, Konzentration und Entspannung für Gruppen, direkt vor Ort in Purkersdorf, Pressbaum und Tullnerbach." title="Workshops für Kindergärten & Schulen" hero="/images/Kinderyoga-64.JPG" jsonLd={jsonLd} heroAlt="Kinderyoga Workshop">

  <div class="grid md:grid-cols-2 gap-12 items-start">

    <div class="flex flex-col gap-6 text-base leading-relaxed" style="color: var(--color-sissi-olive)">
      <p>
        Ich komme direkt zu euch – in den Kindergarten oder in die Schule. Yoga im vertrauten Umfeld senkt die Hemmschwelle und die Kinder können sich sofort auf das Erleben einlassen.
      </p>
      <p>
        Meine Angebote für Bildungseinrichtungen:
      </p>

      <div class="flex flex-col gap-4">
        <div class="p-5 rounded-xl" style="background-color: var(--color-sissi-cream)">
          <h3 class="font-semibold mb-1" style="color: var(--color-sissi-olive)">Workshops</h3>
          <p class="text-sm" style="color: var(--color-sissi-circle)">Einmalige Einheiten zu einem bestimmten Thema – ideal als Projekttag oder besonderes Highlight im Jahresprogramm.</p>
        </div>
        <div class="p-5 rounded-xl" style="background-color: var(--color-sissi-cream)">
          <h3 class="font-semibold mb-1" style="color: var(--color-sissi-olive)">Blöcke</h3>
          <p class="text-sm" style="color: var(--color-sissi-circle)">Mehrteilige Kursblöcke über mehrere Wochen – für einen nachhaltigen Effekt und echten Lernfortschritt.</p>
        </div>
        <div class="p-5 rounded-xl" style="background-color: var(--color-sissi-cream)">
          <h3 class="font-semibold mb-1" style="color: var(--color-sissi-olive)">Pädagogen-Workshops</h3>
          <p class="text-sm" style="color: var(--color-sissi-circle)">Fortbildung für Erzieher:innen und Lehrer:innen – Grundlagen des Kinderyogas für den Einsatz im Alltag der Bildungseinrichtung.</p>
        </div>
      </div>
    </div>

    <div class="flex flex-col gap-6">
      <img src="/images/Kinderyoga-31.JPG" alt="Workshop in der Schule" class="w-full rounded-2xl object-cover shadow-md" />
      <img src="/images/Kinderyoga-73.JPG" alt="Kinder beim Yoga" class="w-full rounded-2xl object-cover shadow-md" />
    </div>

  </div>

  <Faq items={faq} />

  <!-- CTA -->
  <div class="mt-12 p-8 rounded-2xl text-center" style="background-color: var(--color-sissi-cream)">
    <p class="text-lg mb-2" style="color: var(--color-sissi-olive)">Interesse an einem Workshop für eure Einrichtung?</p>
    <p class="text-sm mb-6" style="color: var(--color-sissi-circle)">Ich erstelle gerne ein individuelles Angebot für euch.</p>
    <a href="/kontakt" class="inline-flex items-center gap-2 px-8 py-3 rounded-full text-white font-medium transition hover:scale-105"
       style="background-color: var(--color-sissi-olive)">
      Anfrage stellen
    </a>
  </div>

</SubpageLayout>
