---
import SubpageLayout from '../layouts/SubpageLayout.astro'
---

<SubpageLayout title="Kontakt">

  <div class="max-w-2xl mx-auto flex flex-col gap-10">

    <!-- Kontaktformular -->
    <div class="rounded-2xl p-8 flex flex-col gap-6" style="background-color: var(--color-sissi-cream)">
      <div>
        <p class="text-xs font-bold tracking-widest uppercase mb-1" style="color: var(--color-sissi-green)">Schreib mir</p>
        <h2 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Anfrage stellen</h2>
      </div>

      <form id="kontakt-form" name="kontakt" method="POST" action="/kontakt-danke" data-netlify="true" netlify-honeypot="bot-field" class="flex flex-col gap-4">
        <input type="hidden" name="form-name" value="kontakt" />
        <input type="hidden" name="bot-field" />

        <div class="grid sm:grid-cols-2 gap-4">
          <div class="flex flex-col gap-1">
            <label for="name" class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-sissi-green)">Name *</label>
            <input type="text" id="name" name="name" required
              class="rounded-xl px-4 py-3 text-sm border border-black/10 bg-white outline-none focus:ring-2"
              style="color: var(--color-sissi-olive); --tw-ring-color: var(--color-sissi-green)"
              placeholder="Dein Name" />
          </div>
          <div class="flex flex-col gap-1">
            <label for="email" class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-sissi-green)">E-Mail *</label>
            <input type="email" id="email" name="email" required
              class="rounded-xl px-4 py-3 text-sm border border-black/10 bg-white outline-none focus:ring-2"
              style="color: var(--color-sissi-olive); --tw-ring-color: var(--color-sissi-green)"
              placeholder="deine@email.at" />
          </div>
        </div>

        <div class="grid sm:grid-cols-2 gap-4">
          <div class="flex flex-col gap-1">
            <label for="telefon" class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-sissi-green)">Telefon</label>
            <input type="tel" id="telefon" name="telefon"
              class="rounded-xl px-4 py-3 text-sm border border-black/10 bg-white outline-none focus:ring-2"
              style="color: var(--color-sissi-olive); --tw-ring-color: var(--color-sissi-green)"
              placeholder="+43 ..." />
          </div>
          <div class="flex flex-col gap-1">
            <label for="kurs" class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-sissi-green)">Interesse</label>
            <select id="kurs" name="kurs"
              class="rounded-xl px-4 py-3 text-sm border border-black/10 bg-white outline-none focus:ring-2"
              style="color: var(--color-sissi-olive); --tw-ring-color: var(--color-sissi-green)">
              <option value="">Bitte wählen …</option>
              <option>Kinderyoga</option>
              <option>Prä- & Postnatal Yoga</option>
              <option>Mama Baby Yoga</option>
              <option>Senioren Yoga</option>
              <option>Vinyasa Yoga Flow</option>
              <option>Yoga im Garten</option>
              <option>Schulen & Kindergärten</option>
              <option>Workshop</option>
              <option>Allgemeine Anfrage</option>
            </select>
          </div>
        </div>

        <div class="flex flex-col gap-1">
          <label for="nachricht" class="text-xs font-semibold uppercase tracking-widest" style="color: var(--color-sissi-green)">Nachricht *</label>
          <textarea id="nachricht" name="nachricht" required rows="4"
            class="rounded-xl px-4 py-3 text-sm border border-black/10 bg-white outline-none focus:ring-2 resize-none"
            style="color: var(--color-sissi-olive); --tw-ring-color: var(--color-sissi-green)"
            placeholder="Was möchtest du wissen?"></textarea>
        </div>

        <button type="submit"
          class="self-start px-8 py-3 rounded-full text-white font-medium transition hover:scale-105"
          style="background-color: var(--color-sissi-olive)">
          Absenden
        </button>
      </form>
    </div>

    <!-- Kontaktkarte -->
    <div class="rounded-2xl p-8 flex flex-col gap-6" style="background-color: var(--color-sissi-cream)">

      <div class="flex items-center gap-4">
        <img src="/logos/logo-circle.png" alt="Sissi" class="w-16 h-16 rounded-full" />
        <div>
          <p class="font-semibold text-lg" style="color: var(--color-sissi-olive)">Elisabeth Zehetner</p>
          <p class="text-sm" style="color: var(--color-sissi-circle)">Yoga-Lehrerin · Kinder & Familien</p>
        </div>
      </div>

      <div class="grid sm:grid-cols-3 gap-4 text-sm">

        <div class="flex flex-col gap-1">
          <span class="text-xs uppercase tracking-widest font-semibold" style="color: var(--color-sissi-green)">Telefon</span>
          <a href="tel:+436604860304" class="font-medium hover:opacity-70 transition" style="color: var(--color-sissi-olive)">
            +43 660 4860304
          </a>
        </div>

        <div class="flex flex-col gap-1">
          <span class="text-xs uppercase tracking-widest font-semibold" style="color: var(--color-sissi-green)">E-Mail</span>
          <a href="mailto:sissi.zehetner@gmail.com" class="font-medium hover:opacity-70 transition" style="color: var(--color-sissi-olive)">
            sissi.zehetner@gmail.com
          </a>
        </div>

        <div class="flex flex-col gap-1">
          <span class="text-xs uppercase tracking-widest font-semibold" style="color: var(--color-sissi-green)">Social</span>
          <div class="flex gap-3">
            <a href="https://www.instagram.com/sissi.familien.yogazeit" target="_blank" rel="noopener" class="hover:opacity-70 transition" style="color: var(--color-sissi-olive)">
              Instagram
            </a>
          </div>
        </div>

      </div>


    </div>

    <!-- Instagram CTA -->
    <a href="https://www.instagram.com/sissi.familien.yogazeit" target="_blank" rel="noopener"
       class="flex flex-col items-center gap-3 rounded-2xl p-8 text-white transition hover:scale-[1.02]"
       style="background: linear-gradient(135deg, #f9a8d4, #c084fc, #fb923c)">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24">
        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
      </svg>
      <div class="text-center">
        <p class="font-semibold text-lg">@sissi.familien.yogazeit</p>
        <p class="text-sm opacity-90">Folg mir für aktuelle Termine & Einblicke</p>
      </div>
    </a>

    <!-- Direktkontakt Buttons -->
    <div class="flex flex-col sm:flex-row gap-4">
      <a href="mailto:sissi.zehetner@gmail.com"
         class="flex-1 flex items-center justify-center gap-2 py-4 rounded-full text-white font-medium transition hover:scale-105"
         style="background-color: var(--color-sissi-olive)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
        </svg>
        E-Mail schreiben
      </a>
      <a href="tel:+436604860304"
         class="flex-1 flex items-center justify-center gap-2 py-4 rounded-full font-medium border-2 transition hover:scale-105"
         style="border-color: var(--color-sissi-olive); color: var(--color-sissi-olive)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
        Anrufen
      </a>
    </div>

  </div>

<script>
  const form = document.getElementById('kontakt-form') as HTMLFormElement
  form?.addEventListener('submit', async (e) => {
    e.preventDefault()
    const data = new URLSearchParams(new FormData(form) as any).toString()
    await fetch('/', {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: data,
    })
    window.location.href = '/kontakt-danke'
  })
</script>

</SubpageLayout>
