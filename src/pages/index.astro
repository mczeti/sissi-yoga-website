---
import Layout from '../layouts/Layout.astro'
import { useStoryblokApi } from '@storyblok/astro'
import Stundenplan from '../components/Stundenplan.astro'
import KommendeTermine from '../components/KommendeTermine.astro'
import VideoStage from '../components/VideoStage.astro'

// Flyer aus Storyblok laden
let flyer: any[] = []
try {
  const storyblokApi = useStoryblokApi()
  const { data } = await storyblokApi.get('cdn/stories', {
    content_type: 'flyer',
    sort_by: 'content.gueltig_ab:asc',
    version: 'published',
    cv: Date.now(),
  })
  flyer = data.stories.map((s: any) => s.content)
} catch (e) {
  // Storyblok noch nicht konfiguriert – leere Liste
}

// Temporärer Hinweis: Kurspause wegen Retreat (blendet sich nach dem 28.9. beim nächsten Deploy automatisch aus)
const zeigeKurspauseHinweis = new Date() < new Date('2026-09-29T00:00:00+02:00')

const standorte = [
  {
    name: 'Tullnerbach',
    kurse: ['Yoga im Garten'],
    foto: '/images/yoga-im-garten.jpg',
    fotoPosition: 'center center',
  },
  {
    name: 'Pressbaum',
    kurse: ['Vinyasa Yoga Flow (alle Level)', 'Schwangeren Yoga'],
    foto: '/images/standort-pressbaum.jpg',
    fotoPosition: 'center 40%',
    link: { label: 'Yoga in Pressbaum', href: '/yoga-pressbaum' },
  },
  {
    name: 'Purkersdorf',
    kurse: ['Mama Baby Yoga', 'Senioren Yoga', 'Kinderyoga'],
    foto: '/images/standort-purkersdorf.jpg',
    fotoPosition: 'center center',
    link: { label: 'Yoga in Purkersdorf', href: '/yoga-purkersdorf' },
  },
  {
    name: 'Mobil',
    kurse: ['Kindergärten', 'Schulen'],
    foto: '/images/standort-mobil.jpg',
    fotoPosition: 'center center',
    link: { label: 'Mehr erfahren', href: '/schulen' },
  },
]
// Video-Segmente (Dateien in public/video/<slug>/, erzeugt mit scripts/encode-hero-video.sh).
// Segmente ohne Videodateien erscheinen als Platzhalter (Foto + "Video folgt in Kürze").
// Rotierende Hero-Fotos (Hochformat-Fotos brauchen je einen eigenen Bildausschnitt)
const heroBilder = [
  { src: '/images/achtsamkeit-ritual.jpg', alt: 'Achtsamkeits-Ritual im Garten', position: 'center 60%' },
  { src: '/images/hero-allgemein.jpg', alt: 'Kinder im Kreis beim Yoga mit Sissi', position: 'center center' },
  { src: '/images/seniorenyoga-hero.jpg', alt: 'Seniorenyoga mit Sissi', position: 'center center' },
  { src: '/images/hero-kinderyoga.jpg', alt: 'Kinderyoga-Kreis mit Klangschale', position: 'center 30%' },
]

const videoSegmente = [
  {
    id: 'kids',
    tab: 'Kinderyoga',
    slug: 'kinder',
    title: 'Kinderyoga & Waldyoga',
    subtitle: 'Yoga. Bewegen. Spüren. Spielen.',
    text: 'Tierposen, Geschichten und Atemspiele – Kinder entdecken Yoga mit allen Sinnen. Im Kurs, mit Mama oder Papa und direkt im Kindergarten oder in der Schule.',
    chips: ['Kinderyoga', 'Mama-Baby Yoga', 'Yoga in Kindergärten & Schulen'],
    cta: 'Alle Kinderkurse',
    href: '/kinderyoga',
  },
  {
    id: 'adults',
    tab: 'Erwachsenenyoga',
    slug: 'erwachsene',
    title: 'Vinyasa Flow',
    subtitle: 'Pressbaum · Dienstagabend',
    text: 'Vom kraftvollen Vinyasa Flow bis zum sanften Yoga – Stunden für jedes Level, auch in der Schwangerschaft und für Seniorinnen und Senioren.',
    chips: ['Vinyasa Yoga Flow', 'Schwangeren Yoga', 'Senioren Yoga', 'Yoga im Garten'],
    cta: 'Alle Erwachsenenkurse',
    href: '/workshops',
    placeholderPoster: '/images/yoga-im-garten.jpg',
  },
]

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://sissiyoga.at/#business',
  name: 'Sissi – Familien Yogazeit',
  description: 'Yoga im Wienerwald für Kinder, Familien und Erwachsene: Vinyasa, Sanftes Yoga, Schwangeren-, Mama-Baby-, Senioren- und Kinderyoga.',
  url: 'https://sissiyoga.at/',
  image: 'https://sissiyoga.at/images/Kinderyoga-64.JPG',
  logo: 'https://sissiyoga.at/logos/logo-colored.png',
  telephone: '+436604860304',
  email: 'sissi.zehetner@gmail.com',
  founder: { '@type': 'Person', name: 'Elisabeth Zehetner' },
  areaServed: ['Purkersdorf', 'Pressbaum', 'Tullnerbach', 'Wienerwald'].map((name) => ({ '@type': 'Place', name })),
  knowsAbout: ['Yoga', 'Vinyasa Yoga', 'Sanftes Yoga', 'Erwachsenenyoga', 'Kinderyoga', 'Familienyoga', 'Pränatal-Yoga', 'Postnatal-Yoga', 'Mama-Baby-Yoga', 'Seniorenyoga'],
  sameAs: ['https://www.instagram.com/sissi.familien.yogazeit/'],
}
---

<Layout jsonLd={jsonLd}>

  <!-- HERO: Text links, Foto rechts (ohne Überlappung) -->
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">Yoga im Wienerwald</p>
      <h1>Zeit zum Atmen – für die ganze Familie.</h1>
      <div class="hero-btns">
        <a class="btn btn-primary" href="/#aktuelles"><span class="lbl-long">Workshops &amp; Kurse</span><span class="lbl-short">Kurse</span></a>
        <a class="btn btn-outline" href="/#stundenplan">Stundenplan</a>
      </div>
    </div>
    <div class="banner" data-hero-slideshow>
      {heroBilder.map((bild, i) => (
        <img
          src={bild.src}
          alt={bild.alt}
          class="slide"
          style={`object-position: ${bild.position}; opacity: ${i === 0 ? 1 : 0}`}
          fetchpriority={i === 0 ? 'high' : undefined}
          loading={i === 0 ? 'eager' : 'lazy'}
          decoding="async"
          data-hero-slide
        />
      ))}
      <div class="dots">
        {heroBilder.map((_, i) => (
          <button type="button" aria-label={`Foto ${i + 1} anzeigen`} data-hero-dot><span class:list={{ on: i === 0 }}></span></button>
        ))}
      </div>
    </div>
  </section>

  <!-- VIDEO-SEKTION -->
  <VideoStage
    segments={videoSegmente}
    headline="Wähle deine Yogazeit"
    headlineSingle="Wähle deine Yogazeit"
  />

  <!-- HINWEIS: KURSPAUSE -->
  {zeigeKurspauseHinweis && (
    <section class="py-14 px-8 md:px-16" style="background-color: var(--color-sissi-cream)">
      <div class="max-w-3xl mx-auto rounded-2xl overflow-hidden shadow-md bg-white grid md:grid-cols-[260px_1fr]">
        <div class="flex items-center justify-center p-3" style="background-color: #d8d5cd">
          <img
            src="/images/hinweis-kurspause-sept.jpg"
            alt="Hinweis: Kurspause 22.–28. September, Sissi ist auf Yoga-Retreat in Portugal"
            class="w-full h-auto max-h-96 md:max-h-full object-contain rounded-lg"
          />
        </div>
        <div class="p-8 flex flex-col justify-center gap-2">
          <p class="text-xs font-bold tracking-widest uppercase" style="color: var(--color-sissi-green)">Kurzer Hinweis</p>
          <h3 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Kurspause 22.–28. September</h3>
          <p class="text-sm leading-relaxed" style="color: var(--color-sissi-circle)">
            Ich sammle in Portugal neue Yoga-Ideen und freue mich auf eine Woche Retreat. Ab Dienstag, 29. September bin ich wieder wie gewohnt mit meinem Kursangebot für euch da. Habt es schön!
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- STANDORTE -->
  <section id="termine" class="py-20 px-8 md:px-16 bg-white">
    <div class="max-w-6xl mx-auto">

      <div class="text-center mb-12">
        <p class="text-xs font-bold tracking-widest uppercase mb-2" style="color: var(--color-sissi-green)">Standorte</p>
        <h2 class="text-4xl font-light" style="color: var(--color-sissi-olive)">Yoga in deiner Nähe</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {standorte.map((ort) => (
          <div class="standort-card group relative rounded-2xl overflow-hidden" style="height: 380px;">

            <!-- Foto oder Platzhalter -->
            {ort.foto ? (
              <>
                <img
                  src={ort.foto}
                  alt={`Yoga-Standort ${ort.name}`}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  style={`object-position: ${ort.fotoPosition}`}
                />
                <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(74,82,64,0.15) 0%, rgba(74,82,64,0.0) 35%, rgba(74,82,64,0.75) 70%, rgba(74,82,64,0.95) 100%)"></div>
              </>
            ) : (
              <>
                <div class="absolute inset-0" style="background-color: var(--color-sissi-cream)"></div>
                <div class="absolute inset-0 flex items-center justify-center opacity-20">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20" style="color: var(--color-sissi-olive)" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(74,82,64,0.05) 0%, rgba(74,82,64,0.0) 35%, rgba(74,82,64,0.4) 70%, rgba(74,82,64,0.65) 100%)"></div>
              </>
            )}

            <!-- Top: Standort-Name -->
            <div class="absolute top-0 left-0 right-0 p-5 flex items-center gap-2">
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-full"
                style={ort.foto
                  ? "background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
                  : "background: rgba(74,82,64,0.10);"}>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" style={ort.foto ? "color: white" : "color: var(--color-sissi-olive)"} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="text-sm font-semibold" style={ort.foto ? "color: white" : "color: var(--color-sissi-olive)"}>{ort.name}</span>
              </div>
            </div>

            <!-- Bottom: Kurse + optionaler Link -->
            <div class="absolute bottom-0 left-0 right-0 p-5 flex flex-col gap-2">
              <ul class="flex flex-col gap-1.5">
                {ort.kurse.map((kurs) => (
                  <li class="flex items-center gap-2 text-sm" style={ort.foto ? "color: rgba(255,255,255,0.9)" : "color: var(--color-sissi-circle)"}>
                    <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background-color: var(--color-sissi-green)"></span>
                    {kurs}
                  </li>
                ))}
              </ul>
              {ort.link && (
                <a
                  href={ort.link.href}
                  class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
                  style={ort.foto ? "color: rgba(255,255,255,0.8)" : "color: var(--color-sissi-green)"}
                >
                  {ort.link.label}
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              )}
            </div>

          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TERMINE / FLYER -->
  <KommendeTermine flyer={flyer} />

  <!-- STUNDENPLAN -->
  <section id="stundenplan" class="py-20 px-8 md:px-16 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-bold tracking-widest uppercase mb-2" style="color: var(--color-sissi-green)">Wöchentlich</p>
        <h2 class="text-4xl font-light" style="color: var(--color-sissi-olive)">Stundenplan</h2>
      </div>
      <Stundenplan />
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="px-8 md:px-16 py-10" style="background-color: var(--color-sissi-olive)">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">

      <!-- Left: Logo + name -->
      <div class="flex items-center gap-4">
        <img src="/logos/logo-circle.png" alt="Sissi Familien Yogazeit Logo" class="w-14 h-14 rounded-full" />
        <div>
          <p class="font-semibold text-white">Sissi – Familien Yogazeit</p>
          <p class="text-sm" style="color: rgba(255,255,255,0.6)">Yoga für die ganze Familie</p>
        </div>
      </div>

      <!-- Right: Contact -->
      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 text-sm text-white">
        <a href="tel:+436604860304" class="flex items-center gap-2 opacity-80 hover:opacity-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          +43 660 4860304
        </a>
        <a href="mailto:sissi.zehetner@gmail.com" class="flex items-center gap-2 opacity-80 hover:opacity-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          sissi.zehetner@gmail.com
        </a>
        <a href="https://www.instagram.com/sissi.familien.yogazeit" target="_blank" class="flex items-center gap-2 opacity-80 hover:opacity-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          @sissi.familien.yogazeit
        </a>
      </div>

    </div>

    <div class="max-w-6xl mx-auto mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm" style="color: rgba(255,255,255,0.4)">
      <span>© 2026 Sissi – Familien Yogazeit</span>
      <div class="flex gap-5">
        <a href="/impressum" class="hover:text-white/70 transition">Impressum</a>
        <a href="/datenschutz" class="hover:text-white/70 transition">Datenschutz</a>
      </div>
    </div>
  </footer>

</Layout>

<script>
  const slideshow = document.querySelector<HTMLElement>('[data-hero-slideshow]')
  const slides = document.querySelectorAll<HTMLElement>('[data-hero-slide]')
  const dots = document.querySelectorAll<HTMLElement>('[data-hero-dot] span')
  const INTERVAL = 3500

  if (slideshow && slides.length > 1) {
    let current = 0
    let timer: ReturnType<typeof setInterval> | undefined

    const goTo = (i: number) => {
      if (i === current) return
      slides[current].style.opacity = '0'
      dots[current]?.classList.remove('on')
      current = i
      slides[current].style.opacity = '1'
      dots[current]?.classList.add('on')
    }
    const restart = () => {
      clearInterval(timer)
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
      timer = setInterval(() => goTo((current + 1) % slides.length), INTERVAL)
    }

    restart()
    slideshow.addEventListener('click', () => { goTo((current + 1) % slides.length); restart() })
    document.querySelectorAll<HTMLElement>('[data-hero-dot]').forEach((btn, i) => {
      btn.addEventListener('click', (e) => { e.stopPropagation(); goTo(i); restart() })
    })
  }
</script>

<style>
  .eyebrow { font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-sissi-terracotta); font-weight: 600; margin: 0; }

  .hero {
    display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: 56px; align-items: center;
    max-width: 1440px; margin: 0 auto; padding: 96px 56px 24px;
  }
  .hero-text { display: flex; flex-direction: column; gap: 20px; }
  .hero h1 { margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: 52px; line-height: 1.08; color: var(--color-sissi-ink); text-wrap: pretty; }
  .hero-btns { display: flex; gap: 12px; margin-top: 8px; flex-wrap: wrap; }
  .banner { position: relative; height: 440px; border-radius: 28px; overflow: hidden; cursor: pointer; background: var(--color-sissi-chip); }
  .slide { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .8s ease-in-out; }
  .dots { position: absolute; bottom: 14px; left: 0; right: 0; display: flex; justify-content: center; gap: 4px; }
  .dots button { padding: 8px 4px; border: 0; background: none; cursor: pointer; }
  .dots span { display: block; width: 8px; height: 6px; border-radius: 3px; background: rgba(255, 255, 255, .45); transition: width .5s, background .5s; }
  .dots span.on { width: 24px; background: rgba(255, 255, 255, .95); }
  .lbl-short { display: none; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; padding: 14px 24px; border-radius: 999px;
    font-weight: 500; font-size: 15px; text-decoration: none; transition: transform .2s;
  }
  .btn:hover { transform: scale(1.05); }
  .btn-primary { background: var(--color-sissi-terracotta); color: #fff; }
  .btn-outline { border: 1.5px solid var(--color-sissi-forest); color: var(--color-sissi-forest); }

  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; gap: 0; padding: 72px 12px 0; }
    .banner { order: -1; height: 240px; border-radius: 24px; }
    .hero-text { padding: 24px 8px 0; gap: 14px; }
    .eyebrow { font-size: 12px; }
    .hero h1 { font-size: 32px; line-height: 1.12; }
    .hero-btns { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .hero-btns .btn { height: 48px; padding: 0; }
    .lbl-long { display: none; }
    .lbl-short { display: inline; }
  }
</style>
