---
import Layout from '../layouts/Layout.astro'
import { useStoryblokApi } from '@storyblok/astro'
import Stundenplan from '../components/Stundenplan.astro'

// Flyer aus Storyblok laden
let flyer: any[] = []
try {
  const storyblokApi = useStoryblokApi()
  const { data } = await storyblokApi.get('cdn/stories', {
    content_type: 'flyer',
    sort_by: 'content.gueltig_ab:desc',
    version: import.meta.env.DEV ? 'draft' : 'published',
  })
  flyer = data.stories.map((s: any) => s.content)
} catch (e) {
  // Storyblok noch nicht konfiguriert – leere Liste
}

const standorte = [
  {
    name: 'Purkersdorf',
    kurse: ['Mama Baby Yoga', 'Senioren Yoga', 'Kinderyoga'],
    foto: '/images/standort-purkersdorf.jpg',
    fotoPosition: 'center center',
  },
  {
    name: 'Tullnerbach',
    kurse: ['Yoga im Garten'],
    foto: '/images/standort-tullnerbach.jpg',
    fotoPosition: 'center center',
  },
  {
    name: 'Pressbaum',
    kurse: ['Vinyasa Yoga Flow (alle Level)', 'Schwangeren Yoga'],
    foto: '/images/standort-pressbaum.jpg',
    fotoPosition: 'center 40%',
  },
  {
    name: 'Mobil',
    kurse: ['Kindergärten', 'Schulen'],
    foto: '/images/standort-mobil.jpg',
    fotoPosition: 'center center',
    link: { label: 'Mehr erfahren', href: '/schulen' },
  },
]
---

<Layout>

  <!-- HERO -->
  <section data-hero class="relative min-h-[85vh] md:min-h-screen flex items-center justify-center overflow-hidden">

    <!-- Background image -->
    <div class="absolute inset-0">
      <img
        src="/images/allgemein.JPG"
        alt="Sissi Familien Yogazeit"
        class="w-full h-full object-cover object-center"
      />
      <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(0,0,0,0.35) 0%, rgba(0,0,0,0.2) 50%, rgba(0,0,0,0.5) 100%)"></div>
    </div>

    <!-- Content -->
    <div class="relative z-10 text-center px-6 flex flex-col items-center gap-5 translate-y-16 md:translate-y-24">

      <!-- Logo rund auf milchigem Hintergrund -->
      <div class="flex items-center justify-center rounded-full p-6" style="background: rgba(255,255,255,0.10); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); width: 220px; height: 220px;">
        <img
          src="/logos/logo-white.png"
          alt="Sissi Familien Yogazeit"
          class="w-40 md:w-44"
        />
      </div>

      <a
        href="/#aktuelles"
        class="mt-2 inline-flex items-center gap-3 px-8 py-3 rounded-full font-medium shadow-lg transition hover:scale-105"
        style="background: rgba(255,255,255,0.18); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); color: white; border: 1px solid rgba(255,255,255,0.4)"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z" />
        </svg>
        Workshops & Kurse
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 text-white/60 animate-bounce">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </div>

  </section>

  <!-- STANDORTE -->
  <section id="termine" class="py-20 px-8 md:px-16 bg-white">
    <div class="max-w-6xl mx-auto">

      <div class="text-center mb-12">
        <p class="text-xs font-bold tracking-widest uppercase mb-2" style="color: var(--color-sissi-green)">Standorte</p>
        <h2 class="text-4xl font-light" style="color: var(--color-sissi-olive)">Yoga in deiner Nähe</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {standorte.map((ort) => (
          <div class="standort-card group relative rounded-2xl overflow-hidden" style="height: 380px;">

            <!-- Foto oder Platzhalter -->
            {ort.foto ? (
              <>
                <img
                  src={ort.foto}
                  alt={ort.name}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  style={`object-position: ${ort.fotoPosition}`}
                />
                <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(74,82,64,0.15) 0%, rgba(74,82,64,0.0) 35%, rgba(74,82,64,0.75) 70%, rgba(74,82,64,0.95) 100%)"></div>
              </>
            ) : (
              <>
                <div class="absolute inset-0" style="background-color: var(--color-sissi-cream)"></div>
                <div class="absolute inset-0 flex items-center justify-center opacity-20">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-20 h-20" style="color: var(--color-sissi-olive)" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="absolute inset-0" style="background: linear-gradient(to bottom, rgba(74,82,64,0.05) 0%, rgba(74,82,64,0.0) 35%, rgba(74,82,64,0.4) 70%, rgba(74,82,64,0.65) 100%)"></div>
              </>
            )}

            <!-- Top: Standort-Name -->
            <div class="absolute top-0 left-0 right-0 p-5 flex items-center gap-2">
              <div class="flex items-center gap-2 px-3 py-1.5 rounded-full"
                style={ort.foto
                  ? "background: rgba(255,255,255,0.18); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);"
                  : "background: rgba(74,82,64,0.10);"}>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 shrink-0" style={ort.foto ? "color: white" : "color: var(--color-sissi-olive)"} fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
                <span class="text-sm font-semibold" style={ort.foto ? "color: white" : "color: var(--color-sissi-olive)"}>{ort.name}</span>
              </div>
            </div>

            <!-- Bottom: Kurse + optionaler Link -->
            <div class="absolute bottom-0 left-0 right-0 p-5 flex flex-col gap-2">
              <ul class="flex flex-col gap-1.5">
                {ort.kurse.map((kurs) => (
                  <li class="flex items-center gap-2 text-sm" style={ort.foto ? "color: rgba(255,255,255,0.9)" : "color: var(--color-sissi-circle)"}>
                    <span class="w-1.5 h-1.5 rounded-full shrink-0" style="background-color: var(--color-sissi-green)"></span>
                    {kurs}
                  </li>
                ))}
              </ul>
              {ort.link && (
                <a
                  href={ort.link.href}
                  class="mt-2 inline-flex items-center gap-1.5 text-sm font-medium transition-colors"
                  style={ort.foto ? "color: rgba(255,255,255,0.8)" : "color: var(--color-sissi-green)"}
                >
                  {ort.link.label}
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              )}
            </div>

          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- TERMINE / FLYER -->
  <section id="aktuelles" class="py-20 px-8 md:px-16" style="background-color: var(--color-sissi-cream)">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-bold tracking-widest uppercase mb-2" style="color: var(--color-sissi-green)">Aktuelles</p>
        <h2 class="text-4xl font-light" style="color: var(--color-sissi-olive)">Kommende Termine</h2>
      </div>

      {flyer.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {flyer.map((f) => (
            <div class="rounded-2xl overflow-hidden shadow-md hover:shadow-xl transition-shadow bg-white">
              {f.bild?.filename && (() => {
                const isPdf = f.bild.filename.endsWith('.pdf')
                return isPdf ? (
                  <a href={f.bild.filename} target="_blank" rel="noopener"
                     class="flex flex-col items-center justify-center gap-3 p-10"
                     style="background-color: var(--color-sissi-cream)">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 opacity-40" style="color: var(--color-sissi-olive)" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                    </svg>
                    <span class="text-xs font-medium" style="color: var(--color-sissi-green)">PDF öffnen</span>
                  </a>
                ) : (
                  <a href={f.bild.filename} target="_blank" rel="noopener">
                    <img src={f.bild.filename} alt={f.titel ?? 'Flyer'} class="w-full object-cover" />
                  </a>
                )
              })()}
              <div class="p-4">
                {f.titel && <p class="font-semibold text-sm" style="color: var(--color-sissi-olive)">{f.titel}</p>}
                {f.gueltig_ab && <p class="text-xs mt-1" style="color: var(--color-sissi-circle)">Ab {new Date(f.gueltig_ab).toLocaleDateString('de-AT', { day: 'numeric', month: 'long', year: 'numeric' })}</p>}
              </div>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-center opacity-40" style="color: var(--color-sissi-olive)">
          Termine folgen in Kürze …
        </p>
      )}
    </div>
  </section>

  <!-- STUNDENPLAN -->
  <section id="stundenplan" class="py-20 px-8 md:px-16 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-bold tracking-widest uppercase mb-2" style="color: var(--color-sissi-green)">Wöchentlich</p>
        <h2 class="text-4xl font-light" style="color: var(--color-sissi-olive)">Stundenplan</h2>
      </div>
      <Stundenplan />
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="px-8 md:px-16 py-10" style="background-color: var(--color-sissi-olive)">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">

      <!-- Left: Logo + name -->
      <div class="flex items-center gap-4">
        <img src="/logos/logo-circle.png" alt="Sissi" class="w-14 h-14 rounded-full" />
        <div>
          <p class="font-semibold text-white">Sissi – Familien Yogazeit</p>
          <p class="text-sm" style="color: rgba(255,255,255,0.6)">Yoga für die ganze Familie</p>
        </div>
      </div>

      <!-- Right: Contact -->
      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 text-sm text-white">
        <a href="tel:+436604860304" class="flex items-center gap-2 opacity-80 hover:opacity-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          +43 660 4860304
        </a>
        <a href="mailto:sissi.zehetner@gmail.com" class="flex items-center gap-2 opacity-80 hover:opacity-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          sissi.zehetner@gmail.com
        </a>
        <a href="https://www.instagram.com/sissi.familien.yogazeit" target="_blank" class="flex items-center gap-2 opacity-80 hover:opacity-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          @sissi.familien.yogazeit
        </a>
      </div>

    </div>

    <div class="max-w-6xl mx-auto mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm" style="color: rgba(255,255,255,0.4)">
      <span>© 2026 Sissi – Familien Yogazeit</span>
      <div class="flex gap-5">
        <a href="/impressum" class="hover:text-white/70 transition">Impressum</a>
        <a href="/datenschutz" class="hover:text-white/70 transition">Datenschutz</a>
      </div>
    </div>
  </footer>

</Layout>
