---
import Layout from '../layouts/Layout.astro'
import { useStoryblokApi } from '@storyblok/astro'
import Stundenplan from '../components/Stundenplan.astro'
import KommendeTermine from '../components/KommendeTermine.astro'
import HeroVideo from '../components/HeroVideo.astro'

// Flyer aus Storyblok laden
let flyer: any[] = []
try {
  const storyblokApi = useStoryblokApi()
  const { data } = await storyblokApi.get('cdn/stories', {
    content_type: 'flyer',
    sort_by: 'content.gueltig_ab:asc',
    version: 'published',
    cv: Date.now(),
  })
  flyer = data.stories.map((s: any) => s.content)
} catch (e) {
  // Storyblok noch nicht konfiguriert – leere Liste
}

// Temporärer Hinweis: Kurspause wegen Retreat (blendet sich nach dem 28.9. beim nächsten Deploy automatisch aus)
const zeigeKurspauseHinweis = new Date() < new Date('2026-09-29T00:00:00+02:00')

const standorte = [
  {
    name: 'Purkersdorf',
    kurse: ['Mama Baby Yoga', 'Senioren Yoga', 'Kinderyoga'],
    foto: '/images/standort-purkersdorf.jpg',
    fotoPosition: 'center center',
    link: { label: 'Yoga in Purkersdorf', href: '/yoga-purkersdorf' },
  },
  {
    name: 'Tullnerbach',
    kurse: ['Yoga im Garten'],
    foto: '/images/yoga-im-garten.jpg',
    fotoPosition: 'center center',
  },
  {
    name: 'Pressbaum',
    kurse: ['Vinyasa Yoga Flow (alle Level)', 'Schwangeren Yoga'],
    foto: '/images/standort-pressbaum.jpg',
    fotoPosition: 'center 40%',
    link: { label: 'Yoga in Pressbaum', href: '/yoga-pressbaum' },
  },
  {
    name: 'Mobil',
    kurse: ['Kindergärten', 'Schulen'],
    foto: '/images/standort-mobil.jpg',
    fotoPosition: 'center center',
    link: { label: 'Mehr erfahren', href: '/schulen' },
  },
]
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://sissiyoga.at/#business',
  name: 'Sissi – Familien Yogazeit',
  description: 'Yoga im Wienerwald für Kinder, Familien und Erwachsene: Vinyasa, Sanftes Yoga, Schwangeren-, Mama-Baby-, Senioren- und Kinderyoga.',
  url: 'https://sissiyoga.at/',
  image: 'https://sissiyoga.at/images/Kinderyoga-64.JPG',
  logo: 'https://sissiyoga.at/logos/logo-colored.png',
  telephone: '+436604860304',
  email: 'sissi.zehetner@gmail.com',
  founder: { '@type': 'Person', name: 'Elisabeth Zehetner' },
  areaServed: ['Purkersdorf', 'Pressbaum', 'Tullnerbach', 'Wienerwald'].map((name) => ({ '@type': 'Place', name })),
  knowsAbout: ['Yoga', 'Vinyasa Yoga', 'Sanftes Yoga', 'Erwachsenenyoga', 'Kinderyoga', 'Familienyoga', 'Pränatal-Yoga', 'Postnatal-Yoga', 'Mama-Baby-Yoga', 'Seniorenyoga'],
  sameAs: ['https://www.instagram.com/sissi.familien.yogazeit/'],
}
---

<Layout jsonLd={jsonLd}>

  <!-- HERO: Text + Hochformat-Video im Story-Rahmen -->
  <section class="hero" style="background-color: var(--color-sissi-sand)">
    <div class="hero-text">
      <p class="eyebrow">Yoga im Wienerwald</p>
      <h1>Zeit zum Atmen – für die ganze Familie.</h1>
      <p class="lead">Kinderyoga, Mama-Baby-Yoga, Vinyasa und sanftes Yoga in Pressbaum, Purkersdorf und Tullnerbach.</p>
      <div class="btns">
        <a class="btn btn-primary" href="/#aktuelles">Workshops &amp; Kurse</a>
        <a class="btn btn-outline" href="/#stundenplan">Stundenplan ansehen</a>
      </div>
      <div class="chips">
        {['Pressbaum', 'Purkersdorf', 'Tullnerbach', 'Mobil'].map((ort) => <span>{ort}</span>)}
      </div>
    </div>

    <HeroVideo />

    <a class="ig-link" href="https://www.instagram.com/sissi.familien.yogazeit" target="_blank" rel="noopener">
      Mehr auf Instagram → @sissi.familien.yogazeit
    </a>
  </section>

  <!-- HINWEIS: KURSPAUSE -->
  {zeigeKurspauseHinweis && (
    <section class="py-14 px-8 md:px-16" style="background-color: var(--color-sissi-cream)">
      <div class="max-w-3xl mx-auto rounded-2xl overflow-hidden shadow-md bg-white grid md:grid-cols-[260px_1fr]">
        <div class="flex items-center justify-center p-3" style="background-color: #d8d5cd">
          <img
            src="/images/hinweis-kurspause-sept.jpg"
            alt="Hinweis: Kurspause 22.–28. September, Sissi ist auf Yoga-Retreat in Portugal"
            class="w-full h-auto max-h-96 md:max-h-full object-contain rounded-lg"
          />
        </div>
        <div class="p-8 flex flex-col justify-center gap-2">
          <p class="text-xs font-bold tracking-widest uppercase" style="color: var(--color-sissi-green)">Kurzer Hinweis</p>
          <h3 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Kurspause 22.–28. September</h3>
          <p class="text-sm leading-relaxed" style="color: var(--color-sissi-circle)">
            Ich sammle in Portugal neue Yoga-Ideen und freue mich auf eine Woche Retreat. Ab Dienstag, 29. September bin ich wieder wie gewohnt mit meinem Kursangebot für euch da. Habt es schön!
          </p>
        </div>
      </div>
    </section>
  )}

  <!-- STANDORTE -->
  <section id="termine" class="standorte" style="background-color: var(--color-sissi-sand)">
    <header>
      <p class="eyebrow">Standorte</p>
      <h2>Yoga in deiner Nähe</h2>
    </header>

    <div class="loc-grid">
      {standorte.map((ort) => {
        const Tag = ort.link ? 'a' : 'div'
        return (
          <Tag class="loc" href={ort.link?.href} aria-label={ort.link?.label}>
            <img
              src={ort.foto}
              alt={`Yoga-Standort ${ort.name}`}
              width="480"
              height="360"
              loading="lazy"
              decoding="async"
              style={`object-position: ${ort.fotoPosition}`}
            />
            <b>{ort.name}</b>
            <span>{ort.kurse.join(' · ')}</span>
          </Tag>
        )
      })}
    </div>
  </section>

  <!-- TERMINE / FLYER -->
  <KommendeTermine flyer={flyer} />

  <!-- STUNDENPLAN -->
  <section id="stundenplan" class="py-20 px-8 md:px-16 bg-white">
    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-12">
        <p class="text-xs font-bold tracking-widest uppercase mb-2" style="color: var(--color-sissi-green)">Wöchentlich</p>
        <h2 class="text-4xl font-light" style="color: var(--color-sissi-olive)">Stundenplan</h2>
      </div>
      <Stundenplan />
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="px-8 md:px-16 py-10" style="background-color: var(--color-sissi-olive)">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6">

      <!-- Left: Logo + name -->
      <div class="flex items-center gap-4">
        <img src="/logos/logo-circle.png" alt="Sissi Familien Yogazeit Logo" class="w-14 h-14 rounded-full" />
        <div>
          <p class="font-semibold text-white">Sissi – Familien Yogazeit</p>
          <p class="text-sm" style="color: rgba(255,255,255,0.6)">Yoga für die ganze Familie</p>
        </div>
      </div>

      <!-- Right: Contact -->
      <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 text-sm text-white">
        <a href="tel:+436604860304" class="flex items-center gap-2 opacity-80 hover:opacity-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          +43 660 4860304
        </a>
        <a href="mailto:sissi.zehetner@gmail.com" class="flex items-center gap-2 opacity-80 hover:opacity-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
          sissi.zehetner@gmail.com
        </a>
        <a href="https://www.instagram.com/sissi.familien.yogazeit" target="_blank" class="flex items-center gap-2 opacity-80 hover:opacity-100 transition">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
          </svg>
          @sissi.familien.yogazeit
        </a>
      </div>

    </div>

    <div class="max-w-6xl mx-auto mt-8 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3 text-sm" style="color: rgba(255,255,255,0.4)">
      <span>© 2026 Sissi – Familien Yogazeit</span>
      <div class="flex gap-5">
        <a href="/impressum" class="hover:text-white/70 transition">Impressum</a>
        <a href="/datenschutz" class="hover:text-white/70 transition">Datenschutz</a>
      </div>
    </div>
  </footer>

</Layout>

<style>
  .eyebrow { font-size: 13px; letter-spacing: .16em; text-transform: uppercase; color: var(--color-sissi-terracotta); font-weight: 600; margin: 0; }

  .hero {
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr); gap: 40px; align-items: center;
    padding: 100px max(56px, calc((100vw - 1328px) / 2)) 80px; overflow-x: clip;
  }
  .hero-text { display: flex; flex-direction: column; gap: 26px; }
  .hero h1 {
    margin: 0; font-family: var(--font-serif); font-weight: 400; font-size: 68px; line-height: 1.04;
    color: var(--color-sissi-ink); text-wrap: pretty;
  }
  .lead { margin: 0; font-size: 19px; line-height: 1.6; color: var(--color-sissi-muted); max-width: 500px; font-weight: 300; }
  .btns { display: flex; gap: 12px; flex-wrap: wrap; }
  .btn {
    display: inline-flex; align-items: center; justify-content: center; padding: 15px 26px; border-radius: 999px;
    font-weight: 500; font-size: 16px; text-decoration: none; transition: transform .2s;
  }
  .btn:hover { transform: scale(1.05); }
  .btn-primary { background: var(--color-sissi-terracotta); color: #fff; }
  .btn-outline { border: 1.5px solid var(--color-sissi-forest); color: var(--color-sissi-forest); }
  .chips { display: flex; gap: 10px; flex-wrap: wrap; margin-top: 14px; font-size: 14px; color: var(--color-sissi-muted); }
  .chips span { padding: 7px 14px; border-radius: 999px; background: var(--color-sissi-chip); }
  .ig-link { display: none; font-weight: 500; font-size: 14px; color: var(--color-sissi-forest); text-align: center; }

  .standorte {
    padding: 0 max(56px, calc((100vw - 1328px) / 2)) 64px; display: flex; flex-direction: column; gap: 24px;
  }
  .standorte h2 { margin: 4px 0 0; font-family: var(--font-serif); font-weight: 400; font-size: 40px; color: var(--color-sissi-ink); }
  .loc-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .loc { display: flex; flex-direction: column; gap: 12px; text-decoration: none; color: inherit; }
  .loc img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 16px; transition: transform .5s; }
  a.loc:hover img { transform: scale(1.03); }
  .loc b { font-family: var(--font-serif); font-weight: 400; font-size: 22px; color: var(--color-sissi-ink); }
  .loc span { font-size: 14px; color: var(--color-sissi-muted); line-height: 1.5; }

  @media (max-width: 899px) {
    .hero { grid-template-columns: 1fr; gap: 0; padding: 88px 0 20px; }
    .hero-text { display: contents; }
    .hero .eyebrow, .hero h1, .lead { padding: 0 20px; }
    .hero .eyebrow { font-size: 12px; }
    .hero h1 { font-size: 38px; line-height: 1.08; margin: 16px 0; }
    .lead { font-size: 16px; line-height: 1.55; }
    .btns { order: 5; flex-direction: column; padding: 0 20px; gap: 10px; }
    .btn { height: 52px; }
    .ig-link { display: block; order: 6; padding: 14px 20px 0; }
    .chips { display: none; }

    .standorte { padding: 24px 0 36px; gap: 16px; }
    .standorte header { padding: 0 20px; }
    .standorte h2 { font-size: 30px; }
    .loc-grid { display: flex; overflow-x: auto; gap: 14px; padding: 0 20px; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .loc { flex: none; width: 240px; scroll-snap-align: start; }
  }
</style>
