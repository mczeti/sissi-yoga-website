---
import SubpageLayout from '../layouts/SubpageLayout.astro'
import Faq from '../components/Faq.astro'
import { kurs } from '../data/seo'

const jsonLd = [
  kurs({
    name: 'Yoga in der Schwangerschaft',
    description: 'Sanfte Übungen, Atemtechniken und Entspannung für werdende Mütter – stärkt, entspannt und bereitet auf die Geburt vor. In Pressbaum im Block oder als Drop-in, auch im Garten in Tullnerbach.',
    path: '/praenatal',
    orte: ['Pressbaum', 'Tullnerbach'],
    zielgruppe: 'Schwangere'
  }),
  kurs({
    name: 'Mama-Baby-Yoga',
    description: 'Sanftes Yoga zur Rückbildung nach der Geburt, bei dem das Baby durch Berührungen, Massagen und gemeinsame Übungen Teil der Stunde ist.',
    path: '/praenatal',
    orte: ['Purkersdorf'],
    zielgruppe: 'Mütter mit Baby'
  }),
]

const faq = [
  {
    frage: 'Wo gibt es Schwangerenyoga im Wienerwald?',
    antwort: 'Yoga in der Schwangerschaft unterrichtet Sissi im Stark Studio in Pressbaum, wahlweise im Block oder als Einzeleinheit (Drop-in), und als Yoga im Garten in Tullnerbach-Lawies.'
  },
  {
    frage: 'Was bringt Yoga in der Schwangerschaft?',
    antwort: 'Die sanften Übungen helfen, den veränderten Körper besser wahrzunehmen, Rückenschmerzen zu lindern und Kraft für die Geburt aufzubauen. Dazu kommen Atemtechniken, die auch während der Wehen helfen können.'
  },
  {
    frage: 'Was ist Mama-Baby-Yoga und wo findet es statt?',
    antwort: 'Mama-Baby-Yoga ist sanftes Yoga, das die Rückbildung nach der Geburt unterstützt und Gelassenheit im Babyalltag schenkt. Das Baby ist durch Berührungen, Massagen und gemeinsame Übungen Teil der Stunde. Die Kurse finden im Pfarrsaal Purkersdorf statt.'
  },
  {
    frage: 'Wie melde ich mich an?',
    antwort: 'Über das Kontaktformular auf sissiyoga.at/kontakt, per E-Mail an sissi.zehetner@gmail.com oder telefonisch unter +43 660 4860304. Aktuelle Zeiten und Termine stehen im Stundenplan auf der Startseite.'
  }
]
---

<SubpageLayout seoTitle="Schwangerenyoga Pressbaum & Mama-Baby-Yoga Purkersdorf | Sissi Familien Yogazeit" description="Yoga in der Schwangerschaft in Pressbaum und Mama-Baby-Yoga in Purkersdorf: sanfte Übungen, Atmung und Entspannung für werdende und frischgebackene Mütter." title="Prä- & Postnatal Yoga" hero="/images/praenatal-hero.jpg" jsonLd={jsonLd} heroAlt="Prä und Postnatal Yoga">

  <div class="flex flex-col gap-16">

    <!-- Schwangeren Yoga -->
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <div class="flex flex-col gap-5 text-base leading-relaxed" style="color: var(--color-sissi-olive)">
        <h2 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Yoga in der Schwangerschaft</h2>
        <p>
          Yoga in der Schwangerschaft bringt Körper, Geist und Seele ins Gleichgewicht, stärkt und entspannt gleichermaßen und bereitet so deinen Körper optimal auf die Geburt vor.
        </p>
        <p>
          Die sanften Übungen helfen dir, deinen veränderten Körper besser wahrzunehmen, Rückenschmerzen zu lindern und Kraft für die Geburt aufzubauen. Du lernst Atemtechniken, die dir auch während der Wehen helfen können.
        </p>
      </div>
      <img src="/images/schwangeren.JPG" alt="Yoga in der Schwangerschaft" class="w-full rounded-2xl object-cover shadow-md" style="aspect-ratio: 4/3;" />
    </div>

    <hr style="border-color: var(--color-sissi-cream)" />

    <!-- Mama Baby Yoga -->
    <div class="grid md:grid-cols-2 gap-12 items-center">
      <img src="/images/mama-baby.JPG" alt="Mama Baby Yoga" class="w-full rounded-2xl object-cover shadow-md md:order-first order-last" style="aspect-ratio: 4/3;" />
      <div class="flex flex-col gap-5 text-base leading-relaxed" style="color: var(--color-sissi-olive)">
        <h2 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Mama Baby Yoga</h2>
        <p>
          Bei Mama Baby Yoga handelt es sich um sanftes Yoga, das dich und deinen Körper optimal bei deiner Rückbildung unterstützt, dir hilft Stärke aufzubauen und Gelassenheit im Babyalltag zu gewinnen.
        </p>
        <p>
          Dein Baby ist von Anfang an Teil der Stunde – durch Berührungen, Massagen und gemeinsame Übungen stärkt ihr eure Bindung und ihr findet gemeinsam in eine neue Routine.
        </p>
      </div>
    </div>

  </div>

  <Faq items={faq} />

  <!-- CTA -->
  <div class="mt-12 p-8 rounded-2xl text-center flex flex-col items-center gap-4" style="background-color: var(--color-sissi-cream)">
    <p class="text-lg" style="color: var(--color-sissi-olive)">Interesse an Prä- oder Postnatal Yoga?</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/#stundenplan" class="inline-flex items-center gap-2 px-8 py-3 rounded-full font-medium border-2 transition hover:scale-105"
         style="color: var(--color-sissi-olive); border-color: var(--color-sissi-olive)">
        Aktuelle Termine
      </a>
      <a href="/kontakt" class="inline-flex items-center gap-2 px-8 py-3 rounded-full text-white font-medium transition hover:scale-105"
         style="background-color: var(--color-sissi-olive)">
        Jetzt anfragen
      </a>
    </div>
  </div>

</SubpageLayout>
