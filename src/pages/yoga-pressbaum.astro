---
import SubpageLayout from '../layouts/SubpageLayout.astro'
import OrteLinks from '../components/OrteLinks.astro'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Yoga in Pressbaum',
  serviceType: 'Yoga',
  description: 'Vinyasa Yoga Flow, Slow Vinyasa mit Yoga Nidra und Yoga in der Schwangerschaft im Stark Studio in Pressbaum.',
  url: 'https://sissiyoga.at/yoga-pressbaum/',
  provider: { '@id': 'https://sissiyoga.at/#business' },
  areaServed: { '@type': 'Place', name: 'Pressbaum' },
}
---

<SubpageLayout seoTitle="Yoga in Pressbaum – Vinyasa, Slow Vinyasa & Schwangerenyoga | Sissi" description="Yoga in Pressbaum im Stark Studio: Vinyasa Yoga Flow für alle Level, Slow Vinyasa mit Yoga Nidra und Yoga in der Schwangerschaft – mit Sissi Familien Yogazeit." title="Yoga in Pressbaum" hero="/images/standort-pressbaum.jpg" heroAlt="Yoga-Standort Pressbaum" heroPosition="center 40%" jsonLd={jsonLd}>

  <div class="flex flex-col gap-10 max-w-3xl text-base leading-relaxed" style="color: var(--color-sissi-olive)">

    <p class="text-lg">Im Stark Studio in Pressbaum unterrichte ich regelmäßig Yoga für Erwachsene – von kraftvoll bis sanft, für Anfängerinnen und Fortgeschrittene.</p>

    <div class="flex flex-col gap-3">
      <h2 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Vinyasa Yoga Flow</h2>
      <p>Ein kraftvoller, fließender Yogastil, bei dem Bewegung und Atem im Einklang sind. Die Stunde ist für alle Level geeignet: Du kommst in Bewegung, baust Kraft auf und kannst am Ende wieder zur Ruhe kommen.</p>
    </div>
    <div class="flex flex-col gap-3">
      <h2 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Slow Vinyasa Yoga & Yoga Nidra</h2>
      <p>Langsame, achtsame Bewegungen, Dehnung und Entspannung mit Yoga Nidra und Meditation. Ideal, wenn du Verspannungen lösen und zur Ruhe kommen möchtest.</p>
    </div>
    <div class="flex flex-col gap-3">
      <h2 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Yoga in der Schwangerschaft</h2>
      <p>Sanfte Übungen, Atmung und Entspannung für werdende Mamas in Pressbaum – wahlweise im Block oder als Einzeleinheit (Drop-in).</p>
    </div>
    <div class="flex flex-col gap-3">
      <h2 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Workshops in Pressbaum</h2>
      <p>Immer wieder gibt es besondere Termine, zum Beispiel Vinyasa-Workshops für Frauen mit Meditation, Yoga Nidra und gemeinsamem Basteln. Aktuelle Workshops findest du unter „Kommende Termine" auf der Startseite.</p>
    </div>

    <div class="flex flex-col gap-3">
      <h2 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Gut zu wissen</h2>
      <ul class="list-disc pl-5 flex flex-col gap-2">
      <li>Alle Level sind willkommen – du brauchst keine Vorerfahrung.</li>
      <li>Die aktuellen Zeiten und Termine findest du im <a href="/#stundenplan" class="underline">Stundenplan</a>.</li>
      <li>Anmeldung und Fragen: einfach über das <a href="/kontakt/" class="underline">Kontaktformular</a>, per E-Mail oder telefonisch bei Sissi.</li>
      </ul>
    </div>

  </div>

  <!-- CTA -->
  <div class="mt-12 p-8 rounded-2xl text-center flex flex-col items-center gap-4" style="background-color: var(--color-sissi-cream)">
    <p class="text-lg" style="color: var(--color-sissi-olive)">Interesse an Yoga in Pressbaum?</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/#stundenplan" class="inline-flex items-center gap-2 px-8 py-3 rounded-full font-medium border-2 transition hover:scale-105"
         style="color: var(--color-sissi-olive); border-color: var(--color-sissi-olive)">
        Aktuelle Termine
      </a>
      <a href="/kontakt/" class="inline-flex items-center gap-2 px-8 py-3 rounded-full text-white font-medium transition hover:scale-105"
         style="background-color: var(--color-sissi-olive)">
        Jetzt anfragen
      </a>
    </div>
  </div>

  <OrteLinks aktuell="pressbaum" />

</SubpageLayout>
