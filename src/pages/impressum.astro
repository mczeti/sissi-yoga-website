---
import SubpageLayout from '../layouts/SubpageLayout.astro'
---

<SubpageLayout title="Impressum">

  <div class="max-w-2xl flex flex-col gap-10" style="color: var(--color-sissi-olive)">

    <section class="flex flex-col gap-3">
      <h2 class="text-xs font-bold tracking-widest uppercase" style="color: var(--color-sissi-green)">Angaben gemäß § 5 ECG</h2>
      <p class="font-semibold text-lg">Elisabeth Zehetner</p>
      <p class="text-sm leading-relaxed opacity-80">
        Sissi – Familien Yogazeit<br />
        Lawieserstraße 34C/3<br />
        3013 Tullnerbach<br />
        Österreich
      </p>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-xs font-bold tracking-widest uppercase" style="color: var(--color-sissi-green)">Kontakt</h2>
      <div class="text-sm flex flex-col gap-1 opacity-80">
        <p>Telefon: <a href="tel:+436604860304" class="hover:opacity-60 transition">+43 660 4860304</a></p>
        <p>E-Mail: <a href="mailto:sissi.zehetner@gmail.com" class="hover:opacity-60 transition">sissi.zehetner@gmail.com</a></p>
      </div>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-xs font-bold tracking-widest uppercase" style="color: var(--color-sissi-green)">Unternehmensform</h2>
      <p class="text-sm opacity-80">Einzelunternehmen</p>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-xs font-bold tracking-widest uppercase" style="color: var(--color-sissi-green)">Unternehmensgegenstand</h2>
      <p class="text-sm opacity-80">Yoga-Kurse für Kinder, Familien, Schwangere und Senioren</p>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-xs font-bold tracking-widest uppercase" style="color: var(--color-sissi-green)">Aufsichtsbehörde</h2>
      <p class="text-sm opacity-80">Bezirkshauptmannschaft St. Pölten-Land</p>
    </section>

    <section class="flex flex-col gap-3">
      <h2 class="text-xs font-bold tracking-widest uppercase" style="color: var(--color-sissi-green)">Haftungsausschluss</h2>
      <p class="text-sm leading-relaxed opacity-80">
        Trotz sorgfältiger inhaltlicher Kontrolle übernehmen wir keine Haftung für die Inhalte
        externer Links. Für den Inhalt der verlinkten Seiten sind ausschließlich deren Betreiber
        verantwortlich.
      </p>
    </section>

  </div>

</SubpageLayout>
