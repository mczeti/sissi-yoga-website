---
import SubpageLayout from '../layouts/SubpageLayout.astro'
---

<SubpageLayout title="Sissi Sonnengruss App">

  <div class="max-w-2xl mx-auto flex flex-col gap-8">

    <!-- Intro -->
    <div class="text-center flex flex-col gap-3">
      <p class="text-xs font-bold tracking-widest uppercase" style="color: var(--color-sissi-green)">Jetzt kostenlos laden</p>
      <h2 class="text-2xl font-light" style="color: var(--color-sissi-olive)">Die App für deinen täglichen Sonnengruß</h2>
      <p class="text-sm leading-relaxed" style="color: var(--color-sissi-circle)">
        Geführte Yogaeinheiten, Atemübungen und Entspannung – immer dabei, ganz ohne Internetzugang.
      </p>
    </div>

    <!-- Download Cards -->
    <div class="grid sm:grid-cols-2 gap-4">

      <!-- iOS -->
      <a href="https://apps.apple.com/at/app/sissi-sonnengruss-app/id6778984619"
         target="_blank" rel="noopener"
         class="flex flex-col items-center gap-4 rounded-2xl p-8 transition hover:scale-105"
         style="background-color: var(--color-sissi-cream)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-sissi-olive)">
          <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.8-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13 3.5c.73-.83 1.94-1.46 2.94-1.5.13 1.17-.34 2.35-1.04 3.19-.69.85-1.83 1.51-2.95 1.42-.15-1.15.41-2.35 1.05-3.11z"/>
        </svg>
        <div class="text-center">
          <p class="text-xs font-bold tracking-widest uppercase mb-1" style="color: var(--color-sissi-green)">iPhone & iPad</p>
          <p class="font-semibold" style="color: var(--color-sissi-olive)">Im App Store laden</p>
        </div>
        <span class="w-full flex items-center justify-center py-3 rounded-full text-white text-sm font-medium" style="background-color: var(--color-sissi-olive)">
          Zum App Store →
        </span>
      </a>

      <!-- Android -->
      <a href="/downloads/sissi-sonnengruss.apk"
         download="sissi-sonnengruss.apk"
         class="flex flex-col items-center gap-4 rounded-2xl p-8 transition hover:scale-105"
         style="background-color: var(--color-sissi-cream)">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12" viewBox="0 0 24 24" fill="currentColor" style="color: var(--color-sissi-olive)">
          <path d="M17.523 15.341A7.963 7.963 0 0 0 20 9.5C20 5.364 16.636 2 12.5 2S5 5.364 5 9.5c0 2.19.882 4.174 2.314 5.618L6 17.5l2.5-.5 1 2 2-4 1 1 1-1 2 4 1-2 2.5.5-1.487-2.159zM12.5 4a5.5 5.5 0 1 1 0 11 5.5 5.5 0 0 1 0-11zm-2 3.5a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5zm4 0a.75.75 0 1 0 0 1.5.75.75 0 0 0 0-1.5z"/>
        </svg>
        <div class="text-center">
          <p class="text-xs font-bold tracking-widest uppercase mb-1" style="color: var(--color-sissi-green)">Android</p>
          <p class="font-semibold" style="color: var(--color-sissi-olive)">APK direkt laden</p>
        </div>
        <span class="w-full flex items-center justify-center py-3 rounded-full text-sm font-medium border-2" style="border-color: var(--color-sissi-olive); color: var(--color-sissi-olive)">
          APK herunterladen →
        </span>
      </a>

    </div>

    <!-- Android Hinweis -->
    <div class="rounded-2xl p-6 flex gap-4" style="background-color: var(--color-sissi-cream)">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" style="color: var(--color-sissi-green)">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <div class="flex flex-col gap-1">
        <p class="text-sm font-semibold" style="color: var(--color-sissi-olive)">Hinweis für Android-Nutzer</p>
        <p class="text-sm leading-relaxed" style="color: var(--color-sissi-circle)">
          Nach dem Download die APK-Datei öffnen und die Installation bestätigen. Falls gefragt wird, muss „Installation aus unbekannten Quellen" in den Einstellungen erlaubt werden.
        </p>
      </div>
    </div>

  </div>

</SubpageLayout>
