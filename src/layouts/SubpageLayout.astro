---
import Layout from './Layout.astro'

interface Props {
  title: string
  hero?: string
  heroAlt?: string
}

const { title, hero, heroAlt } = Astro.props
---

<Layout title={`${title} · Sissi Familien Yogazeit`}>

  <!-- Hero Bild -->
  {hero && (
    <div class="relative h-64 md:h-96 overflow-hidden pt-16">
      <img src={hero} alt={heroAlt ?? title} class="w-full h-full object-cover object-center" />
      <div class="absolute inset-0 bg-black/25"></div>
      <div class="absolute inset-0 flex items-end justify-start px-8 md:px-16 pb-8">
        <h1 class="text-3xl md:text-5xl font-light text-white drop-shadow">{title}</h1>
      </div>
    </div>
  )}

  {!hero && (
    <div class="pt-24 pb-6 px-8 md:px-16 max-w-6xl mx-auto">
      <h1 class="text-3xl md:text-5xl font-light" style="color: var(--color-sissi-olive)">{title}</h1>
    </div>
  )}

  <!-- Content -->
  <main class="max-w-6xl mx-auto px-6 md:px-16 py-12">
    <slot />
  </main>

  <!-- Footer minimal -->
  <footer class="px-8 md:px-16 py-8 mt-8" style="background-color: var(--color-sissi-olive)">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-3">
        <img src="/logos/logo-circle.png" alt="Sissi" class="w-10 h-10 rounded-full" />
        <span class="text-sm font-medium text-white">Sissi – Familien Yogazeit</span>
      </a>
      <div class="flex flex-col sm:flex-row items-center gap-4 text-sm text-white/70">
        <a href="mailto:sissi.zehetner@gmail.com" class="hover:text-white transition">sissi.zehetner@gmail.com</a>
        <a href="tel:+436604860304" class="hover:text-white transition">+43 660 4860304</a>
        <a href="/impressum" class="hover:text-white transition">Impressum</a>
        <a href="/datenschutz" class="hover:text-white transition">Datenschutz</a>
      </div>
    </div>
  </footer>

</Layout>
